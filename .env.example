# ==============================================================================
# 政策过期检测器 Policy Validity Detector —— 环境变量模板
# 用法：复制本文件为 .env，按需填写；不填任何 Key 也能完整运行（走 Mock 引擎）
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 【1】运行总开关
# ------------------------------------------------------------------------------
# 强制演示模式：true = 无论是否配置 Key，一律使用本地高仿真案例库
# 留空或 false = 自动判定（配置了搜索 Key -> 真实接口；未配置 -> 无缝降级 Mock）
DEMO_MODE=false

HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 【2】元宝搜索（腾讯云联网搜索 WSA）接入配置
# YUANBAO_PROVIDER 三选一：
#   tencent_cloud —— 腾讯云官方 API（TC3-HMAC-SHA256 签名，本工程已内置签名实现）
#   generic       —— 任意 OpenAI/自建风格的 REST 搜索网关（Bearer Token + JSON POST）
#   mcp           —— MCP over HTTP（JSON-RPC 2.0 tools/call）
#   auto          —— 按已填写的 Key 自动选择（默认）
# ------------------------------------------------------------------------------
YUANBAO_PROVIDER=auto

# —— 模式 A0（推荐）：服务 API KEY 兼容模式 ——
# 控制台「元宝搜索 → 服务 API KEY → 创建」，只填这一把 Key 即可，不需要 SecretId/SecretKey
YUANBAO_API_KEY=
# 默认端点，一般不用改
YUANBAO_APIKEY_BASE=https://api.wsa.cloud.tencent.com
YUANBAO_APIKEY_PATH=/SearchPro

# —— 模式 A：腾讯云标准方式（TC3 签名，可选）——
YUANBAO_SECRET_ID=
YUANBAO_SECRET_KEY=
YUANBAO_TC_ENDPOINT=wsa.tencentcloudapi.com
# WSA 是无地域接口：留空。填 ap-xxx 会返回 UnsupportedRegion
YUANBAO_TC_REGION=
YUANBAO_TC_ACTION=SearchPro
YUANBAO_TC_VERSION=2025-05-08

# —— 模式 B：通用 REST 搜索网关 ——
# 若你的网关使用 Bearer 鉴权，将 Key 填在 YUANBAO_API_KEY
YUANBAO_API_KEY=
YUANBAO_API_BASE=https://api.yuanbao.example.com
YUANBAO_SEARCH_PATH=/v1/search
# 请求体中的查询字段名，不同网关可能叫 query / q / keyword
YUANBAO_QUERY_FIELD=query

# —— 模式 C：MCP 接口 ——
YUANBAO_MCP_URL=
YUANBAO_MCP_TOKEN=
YUANBAO_MCP_TOOL=yuanbao_search

# 单次请求超时（秒）与重试次数：超时/失败会自动降级到 Mock，不会让页面报错
YUANBAO_TIMEOUT=12
YUANBAO_RETRIES=2
# 返回条数，合法下界 10（低于 10 会报 illegal Cnt）
YUANBAO_TOP_K=10
# 是否使用系统代理：国内直连更快，默认 false
YUANBAO_TRUST_ENV=false

# ------------------------------------------------------------------------------
# 【3】判定引擎：确定性规则，无需任何额外配置
# 四态判定、时间轴、条款对比均由 core/validity_judge.py 按证据推导
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 【4】其它
# ------------------------------------------------------------------------------
# 允许跨域来源，逗号分隔；* 表示全部放开（本地演示用）
CORS_ORIGINS=*

# 企业微信 / 飞书 webhook 校验 Token（留空则跳过校验，仅本地演示）
WEBHOOK_TOKEN=
